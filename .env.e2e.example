# Copy this file to .env.e2e.local and fill it with dedicated non-production values.
E2E_ENV=local

# Use origin URLs only. API tests include the /api/v1 path in each request.
E2E_API_URL=
E2E_CITIZEN_URL=
E2E_PORTAL_URL=

# Staging only: comma-separated exact hostnames for the three URLs above.
E2E_ALLOWED_HOSTS=

# Destructive CRUD and rate-limit cases are opt-in and stay off by default.
E2E_ALLOW_MUTATIONS=false
E2E_RUN_RATE_LIMIT_TESTS=false

# Dedicated backend accounts for the five seeded backend roles.
E2E_SUPER_ADMIN_USERNAME=
E2E_SUPER_ADMIN_PASSWORD=
E2E_SUB_CITY_ADMIN_USERNAME=
E2E_SUB_CITY_ADMIN_PASSWORD=
E2E_WOREDA_ADMIN_USERNAME=
E2E_WOREDA_ADMIN_PASSWORD=
E2E_BUREAU_ADMIN_USERNAME=
E2E_BUREAU_ADMIN_PASSWORD=
E2E_STAFF_USERNAME=
E2E_STAFF_PASSWORD=

# IDs for a disposable hierarchy used by role and data-scope checks.
E2E_SUB_CITY_ORG_ID=
E2E_WOREDA_ORG_ID=
E2E_BUREAU_ORG_ID=
E2E_SIBLING_WOREDA_ORG_ID=
E2E_SIBLING_BUREAU_ORG_ID=
E2E_OTHER_SUB_CITY_ORG_ID=
